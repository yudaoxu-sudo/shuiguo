# 登录信息和钉钉密钥只放本地 .env，不提交 git。
ZHIMADI_URL=https://aems.zhimadi.cn/index.php?s=/Index/index.html
ZHIMADI_USERNAME=
ZHIMADI_PASSWORD=

LEMENG_URL=https://sharec.lemengcloud.com/pos/home
LEMENG_USERNAME=
LEMENG_PASSWORD=

# 抖音来客后台本月汇总。登录信息只放 .env，不提交 git。
DOUYIN_ENABLED=false
DOUYIN_FINANCE_URL=https://life.douyin.com/p/finance/v2/home
DOUYIN_PHONE=
DOUYIN_PASSWORD=
# 可选：只在指定日期的定时任务发送聚合接口版和网页版两份完整报告。
DUAL_DOUYIN_REPORT_DATE=
LEMENG_FEE_RATE=0.003

DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALERT_MOBILES=
DINGTALK_ALERT_ALL=false

# 可选：用于自动识别芝麻地图形验证码。留空时会发验证码图片到钉钉让人回复。
OPENAI_API_KEY=
OPENAI_CAPTCHA_MODEL=gpt-4o-mini

# 可选：本地 ddddocr 先识别芝麻地图形验证码，识别失败再走 OpenAI/钉钉人工回复。
DDDDOCR_ENABLED=true
DDDDOCR_PYTHON=
DDDDOCR_TIMEOUT_MS=15000
ZHIMADI_CAPTCHA_AUTO_ATTEMPTS=2

# 本地调试先用 false，看得见浏览器；服务器上改 true。
HEADLESS=false

# 本地/服务器排查时可设为 1，只输出报表，不推送钉钉。
NO_DINGTALK=0

# 单个平台读取失败时自动重试次数。
REPORT_STEP_ATTEMPTS=3
# 每次重试前的退避间隔（毫秒，逗号分隔）。平台短时抽风靠拉开时间自愈，别再 5 秒连打三次。
REPORT_RETRY_BACKOFF_MS=5000,30000,120000
# 单次报表进程的总预算。剩余时间不够下一轮退避就提前收手，避免被父进程 watchdog 直接杀掉。
REPORT_TOTAL_BUDGET_MS=780000

# 抖音页面等待超时。页面卡首屏时先把这里调大，不用改代码重新部署。
DOUYIN_NAVIGATION_TIMEOUT_MS=60000
DOUYIN_PAGE_READY_TIMEOUT_MS=90000
DOUYIN_TABLE_TIMEOUT_MS=60000
# 单次抖音读取已经耗掉这么久，就不再做整页刷新重试，把机会留给上层退避。
DOUYIN_RELOAD_CUTOFF_MS=300000

# output/debug 里调试截图和文本的保留天数。只清这两类文件，
# 不会碰 output/browser-profile（登录态）、状态 json 和 report-history 归档。
DEBUG_ARTIFACT_RETENTION_DAYS=7

BROWSER_LOCK_WAIT_MS=600000
BROWSER_LOCK_STALE_MS=1800000
REPORT_HEALTHCHECK_TIMEOUT_MS=600000
LOGIN_HEALTHCHECK_TIMEOUT_MS=600000
# 登录或报表预检遇到可恢复异常时，先在静默窗口内自动复验；恢复后不报警。
HEALTH_RECOVERY_WINDOW_MS=1200000
HEALTH_RETRY_INTERVAL_MS=60000
# 芝麻地自动修复明确失败或超时后，按退避重新发起，验证码等待期间不重复。
ZHIMADI_REPAIR_RETRY_MS=180000

# Mac 本地可用系统 Chrome；服务器通常留空并运行 `pnpm exec playwright install chromium`。
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 保存登录态。第一次手动登录后，后续定时任务复用这里的 Cookie。
USER_DATA_DIR=output/browser-profile
